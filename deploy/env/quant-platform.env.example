# Runtime binding
QP_HOST=127.0.0.1
QP_PORT=8080

# Secrets (replace in production)
MODEL_SIGNING_KEY=replace-with-long-random-signing-key
KILL_SWITCH_REASON_SECRET=replace-with-long-random-reason-secret

# Jurisdiction policy
JURISDICTION_POLICY_VERSION=2026.02
JURISDICTION_PRIMARY=Iceland
JURISDICTION_BACKUP=Switzerland

# Audit durability paths
AUDIT_SQLITE_PATH=/var/lib/quant-platform/audit/audit_events.sqlite3
AUDIT_OBJECT_STORE_PATH=/var/lib/quant-platform/audit/object_store.ndjson
AUDIT_CHECKPOINT_PATH=/var/lib/quant-platform/checkpoints/off_provider_checkpoint.txt
AUDIT_FLUSH_INTERVAL_SECONDS=60

# Feature and credential policy
FEATURE_STALE_AFTER_HOURS=24
CREDENTIAL_OVERLAP_HOURS=24
CREDENTIAL_ROTATION_DAYS=90

# Optional metadata
APP_NAME=Quant Research Platform v1.2
APP_DISCLAIMER=Decision-support output only. Not investment advice.
