# Rust gRPC gateway bind
RUST_GATEWAY_HOST=0.0.0.0
RUST_GATEWAY_PORT=50051

# Python serving backend
PYTHON_BACKEND_URL=http://127.0.0.1:8080

# mTLS policy
RUST_REQUIRE_MTLS=true
RUST_TLS_SERVER_CERT_PATH=/etc/quant-platform/tls/server.crt
RUST_TLS_SERVER_KEY_PATH=/etc/quant-platform/tls/server.key
RUST_TLS_CLIENT_CA_CERT_PATH=/etc/quant-platform/tls/client-ca.crt
RUST_TLS_CLIENT_CN_ALLOWLIST=ops-client-1,ops-client-2

# Rust-owned audit persistence (Postgres + S3)
RUST_AUDIT_ENABLED=true
RUST_AUDIT_FLUSH_INTERVAL_SECONDS=60
RUST_AUDIT_SIGNING_KEY=replace-with-long-random-audit-signing-key
RUST_AUDIT_POSTGRES_DSN=postgres://quant:replace-password@127.0.0.1:5432/quant_platform
RUST_AUDIT_S3_BUCKET=quant-platform-audit-prod
RUST_AUDIT_S3_REGION=us-east-1
# Optional for S3-compatible object stores (e.g. MinIO)
# RUST_AUDIT_S3_ENDPOINT=https://s3.example.internal
RUST_AUDIT_S3_PREFIX=quant-platform/audit

# Logging
RUST_LOG=info
