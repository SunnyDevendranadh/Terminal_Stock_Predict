TC_GRPC_ENDPOINT=https://127.0.0.1:50051
TC_TLS_ENABLED=true
TC_TLS_DOMAIN_NAME=localhost
TC_TLS_CA_CERT_PATH=/etc/quant-platform/tls/client-ca.crt
TC_TLS_CLIENT_CERT_PATH=/etc/quant-platform/tls/ops-client.crt
TC_TLS_CLIENT_KEY_PATH=/etc/quant-platform/tls/ops-client.key
# Optional startup passphrase check
# TC_TLS_CERT_PASSWORD=replace-me

TC_REFRESH_SECONDS=30
TC_ACTOR=terminal-client
TC_MODEL_VERSION=current
TC_SYMBOLS=BTCUSD,ETHUSD,SPY,QQQ,NVDA,TSLA,AAPL,MSFT,GLD,TLT,EURUSD,JPYUSD,CL1,SI1,ES1,NQ1
TC_CACHE_PATH=/var/lib/quant-platform/terminal-client/cache.sqlite3
